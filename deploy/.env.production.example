# 将本文件复制为服务器上的
# /opt/apps/bangni-shuochukou/.env.production 后再填写真实值。
# 绝不能将 .env.production 提交到 GitHub。

# MySQL 已在共享 app-net 中运行，使用 Compose 服务名 mysql 直连。
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=请替换为高强度数据库密码
DB_DATABASE=db_bangni

# 使用命令生成：openssl rand -hex 32
APP_KEYS=请替换为随机字符串

# 镜像地址由 GitHub Actions 每次部署时自动覆盖，无需手工填写。
BACKEND_IMAGE=ghcr.io/你的GitHub用户名/send-backend-midway:v0.0.0
ADMIN_IMAGE=ghcr.io/你的GitHub用户名/send-frontend-admin:v0.0.0
H5_IMAGE=ghcr.io/你的GitHub用户名/send-frontend-app:v0.0.0
